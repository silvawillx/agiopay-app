# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase
# (Project Settings -> API, no painel do Supabase)

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=coloque-aqui-a-chave-anon-public

# ---- Só para o painel /admin (lado do SERVIDOR) ----
# Project Settings -> API -> "service_role" (secret). NUNCA coloque o prefixo
# VITE_ nessa chave: com VITE_ ela vai parar no navegador e qualquer um pega.
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-chave-service-role
# emails que podem entrar no /admin, separados por vírgula
ADMIN_EMAILS=seuemail@exemplo.com

# ---- Cobrança com o Asaas (SERVIDOR da Vercel; nunca com o prefixo VITE_) ----
# Chave da API do Asaas. Comece com a do SANDBOX (ambiente de testes, não cobra de verdade).
ASAAS_API_KEY=coloque-aqui-a-chave-do-asaas
# sandbox (testes) ou production (cobra de verdade)
ASAAS_AMBIENTE=sandbox
# valor da mensalidade em R$ (padrão 15)
ASAAS_VALOR_MENSAL=15
# senha combinada com o Asaas pro aviso de pagamento: invente uma frase longa e aleatória
# e use a MESMA no painel do Asaas (Integrações → Webhooks → Token de autenticação)
ASAAS_WEBHOOK_TOKEN=invente-uma-senha-longa-aqui
# O webhook aponta para: https://SEU-DOMINIO/api/webhook-asaas
